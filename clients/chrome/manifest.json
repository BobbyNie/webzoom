{
  "manifest_version": 3,
  "name": "WebZoom LAN Relay",
  "version": "0.2.0",
  "description": "Approved-site LAN screen-sharing relay. Requires the user-level WebZoom native host.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}

PUBLIC_URL=https://webzoom.example.intranet
OIDC_ISSUER=https://keycloak.example.intranet/realms/company
OIDC_CLIENT_ID=webzoom
OIDC_CLIENT_SECRET_FILE=./.secrets/oidc_client_secret
METRICS_TOKEN_FILE=./.secrets/metrics_token
TLS_CERT_FILE=./certs/fullchain.pem
TLS_KEY_FILE=./certs/privkey.pem

# Disabled for normal deployment. Positive values are for isolated load tests only.
LOAD_TEST_MAX_ROOMS=0
LOAD_TEST_MAX_VIEWERS=0

# Comma-separated OIDC sub values, not usernames. Empty disables admin access.
ADMIN_USER_IDS=

# Bootstrap only. Saved administrator settings on the persistent volume take precedence.
TOTAL_BANDWIDTH_LIMIT_MBPS=200

# Optional LAN pilot: application process variables, OFF by default.
# Existing Compose/OCP manifests do not automatically forward these settings.
# Read docs/LAN_RELAY_IMPLEMENTATION.md and obtain IT approval before enabling.
# Budget is application MEDIA EGRESS, not a 20 Mbps physical-link guarantee.
# LAN_RELAY_ENABLED=false
# LAN_MEDIA_BUDGET_MBPS=16
